# VidyaSaathi Environment Configuration
# Optional: Provide Google Gemini API Key for live multimodal agent generation
# If not provided, VidyaSaathi automatically operates with built-in high-fidelity agents!
GEMINI_API_KEY=your_gemini_api_key_here

# Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# BigQuery & GCP Project (Production)
GCP_PROJECT_ID=vidyasaathi-production
BIGQUERY_DATASET=vidyasaathi_analytics
