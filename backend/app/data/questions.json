  {
    "id": "q_frac_type_1",
    "concept_id": "frac_proper_improper",
    "difficulty": 1,
    "type": "mcq",
    "question_text": {
      "en": "Which fraction is larger: 1/2 or 1/4?",
      "hi": "कौन सा भिन्न बड़ा है: 1/2 या 1/4?",
      "mr": "कोणता अपूर्णांक मोठा आहे: १/२ की १/४?"
    },
    "options": [
      {
        "id": "A",
        "text": { "en": "1/2 is larger", "hi": "1/2 बड़ा है", "mr": "१/२ मोठा आहे" },
        "is_correct": true,
        "misconception_id": null
      },
      {
        "id": "B",
        "text": { "en": "1/4 is larger", "hi": "1/4 बड़ा है", "mr": "१/४ मोठा आहे" },
        "is_correct": false,
        "misconception_id": "misc_frac_separate_numbers"
      },
      {
        "id": "C",
        "text": { "en": "Both are equal", "hi": "दोनों बराबर हैं", "mr": "दोन्ही समान आहेत" },
        "is_correct": false,
        "misconception_id": null
      },
      {
        "id": "D",
        "text": { "en": "Cannot be compared", "hi": "तुलना नहीं की जा सकती", "mr": "तुलना करता येत नाही" },
        "is_correct": false,
        "misconception_id": null
      }
    ],
    "correct_answer": "A",
    "explanation": {
      "en": "1/2 represents half of the whole, while 1/4 is only a quarter. Dividing into fewer parts yields larger pieces, so 1/2 > 1/4.",
      "hi": "1/2 आधा हिस्सा है जबकि 1/4 केवल चौथाई। 1 रोटी के 2 टुकड़े करने पर टुकड़ा बड़ा मिलता है, अतः 1/2 > 1/4।",
      "mr": "१/२ म्हणजे अर्धा भाग तर १/४ म्हणजे पाव भाग. २ तुकडे केल्यास भाग मोठा मिळतो, म्हणून १/२ > १/४."
    },
    "teacher_verified": true
  },
