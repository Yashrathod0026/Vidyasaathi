  {
    "id": "q_int_basic_1",
    "concept_id": "int_basic",
    "difficulty": 1,
    "type": "mcq",
    "question_text": {
      "en": "Which of the following numbers is the smallest?",
      "hi": "निम्नलिखित में से कौन सी संख्या सबसे छोटी है?",
      "mr": "खालीलपैकी कोणती संख्या सर्वात लहान आहे?"
    },
    "options": [
      {
        "id": "A",
        "text": { "en": "-8", "hi": "-8", "mr": "-८" },
        "is_correct": true,
        "misconception_id": null
      },
      {
        "id": "B",
        "text": { "en": "-2", "hi": "-2", "mr": "-२" },
        "is_correct": false,
        "misconception_id": "misc_int_magnitude_neg"
      },
      {
        "id": "C",
        "text": { "en": "0", "hi": "0", "mr": "०" },
        "is_correct": false,
        "misconception_id": null
      },
      {
        "id": "D",
        "text": { "en": "3", "hi": "3", "mr": "३" },
        "is_correct": false,
        "misconception_id": null
      }
    ],
    "correct_answer": "A",
    "explanation": {
      "en": "On a number line, numbers further to the left are smaller. -8 is to the left of -2, 0, and 3, so -8 is the smallest.",
      "hi": "संख्या रेखा पर जो संख्या बाईं ओर होती है वह छोटी होती है। -8 सबसे बाईं ओर है, इसलिए -8 सबसे छोटी संख्या है।",
      "mr": "संख्या रेषेवर डावीकडील संख्या सर्वात लहान असते. -८ हे सर्वात डावीकडे असल्याने ते सर्वात लहान आहे."
    },
    "teacher_verified": true
  },
